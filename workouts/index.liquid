---
permalink: /workouts/index.html
layout: default
title: "Workouts"
description: "My Strava activities"
noPageHeader: true
---

<h1>Workouts</h1>

<p class="muted">{{ workouts.size }} activities, via Strava.</p>

<dl>
  <dt>Total distance</dt><dd>{{ workoutStats.totalDistanceKm }} km</dd>
  <dt>Total runs</dt><dd>{{ workoutStats.totalRuns }}</dd>
  <dt>Average pace</dt><dd>{{ workoutStats.avgPace }} /km</dd>
  <dt>Longest</dt><dd>{{ workoutStats.longestKm }} km</dd>
</dl>

<h2>Log</h2>

<div class="table-wrap">
<table class="workouts">
  <thead>
    <tr><th class="c-route"><span class="sr-only">Route</span></th><th>Activity</th><th class="num">Dist</th><th class="num">Time</th><th class="num">Pace</th><th class="num">HR</th></tr>
  </thead>
  <tbody>
{%- for workout in workouts -%}
{%- assign activity = workout.data.activity -%}
{%- if activity %}
    <tr>
      <td class="c-route">{% if workout.svgPath %}<div class="route route--thumb" aria-hidden="true">{% include workout.svgPath %}</div>{% endif %}</td>
      <td><a href="https://www.strava.com/activities/{{ activity.id }}" rel="noopener noreferrer">{{ activity.name }}</a><br><time class="muted" datetime="{{ activity.start_date }}">{{ activity.start_date | date: '%Y-%m-%d %H:%M' }}</time></td>
      <td class="num">{% if activity.distance %}{{ activity.distance | divided_by: 1000.0 | round: 2 }}{% else %}<span class="muted">-</span>{% endif %}</td>
      {%- if activity.moving_time -%}
        {%- assign total_seconds = activity.moving_time -%}
        {%- assign minutes = total_seconds | divided_by: 60 | floor -%}
        {%- assign seconds = total_seconds | modulo: 60 | round -%}
        {%- assign padded_seconds = seconds | prepend: "0" | slice: -2, 2 %}
      <td class="num">{{ minutes }}:{{ padded_seconds }}</td>
      {%- else %}
      <td class="num muted">-</td>
      {%- endif -%}
      {%- if activity.average_speed -%}
        {%- assign pace = 1000 | divided_by: activity.average_speed | divided_by: 60 -%}
        {%- assign paceMin = pace | floor -%}
        {%- assign paceSec = pace | minus: paceMin | times: 60 | round %}
      <td class="num">{{ paceMin }}:{{ paceSec | prepend: "0" | slice: -2, 2 }}</td>
      {%- else %}
      <td class="num muted">-</td>
      {%- endif %}
      <td class="num">{% if activity.average_heartrate %}{{ activity.average_heartrate | round }}{% else %}<span class="muted">-</span>{% endif %}</td>
    </tr>
{%- endif -%}
{%- endfor %}
  </tbody>
</table>
</div>
