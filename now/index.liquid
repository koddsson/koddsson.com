---
permalink: /now/index.html
layout: default
title: "Now"
description: "What I'm currently doing — latest run, current book, now playing — built from live feeds."
noPageHeader: true
---

<h1>Now</h1>

<p class="muted">As of {{ buildDate | date: '%Y-%m-%d %H:%M' }} UTC. Built from {{ now.feeds.size }} feeds; <a href="https://github.com/koddsson/koddsson.com">source on GitHub</a>.</p>

{% if latestRun %}
<h2>Latest run</h2>

<p><strong>{{ latestRun.name }}</strong><br>
<span class="muted">Strava{% if latestRun.ago %} · {{ latestRun.ago }}{% endif %}{% if latestRun.device %} · {{ latestRun.device }}{% endif %}{% if latestRun.plan %} · {{ latestRun.plan }}{% endif %}</span></p>

{% if latestRun.routeSvg %}
<div class="route route--large" aria-hidden="true">{{ latestRun.routeSvg }}</div>
{% endif %}

<dl>
  <dt>Distance</dt><dd>{{ latestRun.distanceKm }} km</dd>
  <dt>Pace</dt><dd>{{ latestRun.pacePerKm }} /km</dd>
  <dt>Moving</dt><dd>{{ latestRun.movingTime }}</dd>
  <dt>Elevation</dt><dd>+{{ latestRun.elevGain }} m</dd>
</dl>
{% endif %}

{% if reading %}
<h2>Reading</h2>

<p><strong>{{ reading.title }}</strong><br>
<span class="muted">Goodreads{% if reading.startedAt %} · started {{ reading.startedAt | date: '%b %-d' }}{% endif %}{% if reading.updatedAt %} · updated {{ reading.updatedAt | date: '%b %-d' }}{% endif %}</span></p>

{% if reading.pct %}
{%- assign filled = reading.pct | divided_by: 4 | round -%}
<p role="img" aria-label="{{ reading.pct }}% complete">[{% for i in (1..25) %}{% if i <= filled %}#{% else %}<span class="muted">.</span>{% endif %}{% endfor %}] {{ reading.pct }}%</p>
{% endif %}
{% endif %}
